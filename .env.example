NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternatif untuk project Supabase dengan legacy anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origin aplikasi, wajib sama dengan URL yang diizinkan di Supabase Auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opsional: email pengingat tugas (semuanya khusus server, bukan NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
REMINDER_EMAIL_FROM=
# Random minimal 16 karakter; Vercel mengirimkannya melalui Authorization.
CRON_SECRET=
